// Copy to wrangler.reminders.local.jsonc before deploying.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wechatai-reminders",
  "main": "src/server/reminder-scheduler.ts",
  "compatibility_date": "2026-10-10",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "REMINDERS", "class_name": "ReminderScheduler" },
      { "name": "ACCOUNTS", "class_name": "PersonalAccount", "script_name": "wechatai" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReminderScheduler"] }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
