// Local defaults and a production template. See docs/deployment.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wechatai",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": [
      "/api/*",
      "/invite/*",
      "/developers/plugins.md",
      "/developers/openclaw.md",
      "/developers/hermes.md",
      "/developers/notifications.md",
      "/llms.txt",
    ],
  },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "wechatai-media" }],
  "send_email": [{ "name": "AUTH_EMAIL" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wechatai-db",
      "database_id": "local-wechatai-db",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": { "bindings": [
    { "name": "ACCOUNTS", "class_name": "PersonalAccount" },
    { "name": "REMINDERS", "class_name": "ReminderScheduler" }
  ] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PersonalAccount"] },
    { "tag": "v2-local-reminders", "new_sqlite_classes": ["ReminderScheduler"] }
  ],
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "12001", "simple": { "limit": 20, "period": 60 } },
    { "name": "API_LIMIT", "namespace_id": "12002", "simple": { "limit": 120, "period": 60 } },
  ],
  "vars": {
    "APP_NAME": "微伴",
    "APP_URL": "http://localhost:5173",
    "AUTH_EMAIL_MODE": "preview",
    "AUTH_EMAIL_FROM": "",
    "PUBLIC_SITE_URL": "https://wechatai.app",
    "FREE_DAILY_CREDITS": "100",
    "PLUS_DAILY_CREDITS": "1000",
    "FREE_ASSISTANTS": "3",
    "PLUS_ASSISTANTS": "20",
    "FREE_SESSIONS": "10",
    "PLUS_SESSIONS": "200",
    "LLM_ALLOWED_HOSTS": "",
    "KIMISEEK_URL": "http://localhost:3000",
    "KIMISEEK_API_URL": "http://localhost:3000",
  },
  "env": {
    "production": {
      "name": "wechatai",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "example.com", "custom_domain": true }],
      "triggers": { "crons": ["* * * * *"] },
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "wechatai-media" }],
      "send_email": [{ "name": "AUTH_EMAIL" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "wechatai-db",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
      "durable_objects": { "bindings": [
        { "name": "ACCOUNTS", "class_name": "PersonalAccount" },
        { "name": "REMINDERS", "class_name": "ReminderScheduler", "script_name": "wechatai-reminders" }
      ] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PersonalAccount"] }],
      "ratelimits": [
        { "name": "AUTH_LIMIT", "namespace_id": "12001", "simple": { "limit": 20, "period": 60 } },
        { "name": "API_LIMIT", "namespace_id": "12002", "simple": { "limit": 120, "period": 60 } },
      ],
      "vars": {
        "APP_NAME": "微伴",
        "APP_URL": "https://example.com",
        "AUTH_EMAIL_MODE": "cloudflare",
        "AUTH_EMAIL_FROM": "",
        "PUBLIC_SITE_URL": "https://example.com",
        "FREE_DAILY_CREDITS": "100",
        "PLUS_DAILY_CREDITS": "1000",
        "FREE_ASSISTANTS": "3",
        "PLUS_ASSISTANTS": "20",
        "FREE_SESSIONS": "10",
        "PLUS_SESSIONS": "200",
        "LLM_ALLOWED_HOSTS": "",
        "KIMISEEK_URL": "https://kimiseek.app",
        "KIMISEEK_API_URL": "https://api.kimiseek.app",
      },
    },
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
