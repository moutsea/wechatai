{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wechatai",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": [
      "/api/*",
      "/invite/*",
      "/developers/plugins.md",
      "/developers/openclaw.md",
      "/developers/hermes.md",
      "/llms.txt",
    ],
  },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "wechatai-media" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wechatai-db",
      "database_id": "local-wechatai-db",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": { "bindings": [{ "name": "ACCOUNTS", "class_name": "PersonalAccount" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PersonalAccount"] }],
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "12001", "simple": { "limit": 20, "period": 60 } },
    { "name": "API_LIMIT", "namespace_id": "12002", "simple": { "limit": 120, "period": 60 } },
  ],
  "vars": {
    "APP_NAME": "微伴",
    "APP_URL": "http://localhost:5173",
    "PUBLIC_SITE_URL": "https://wechatai.app",
    "FREE_DAILY_CREDITS": "100",
    "PLUS_DAILY_CREDITS": "1000",
    "FREE_ASSISTANTS": "3",
    "PLUS_ASSISTANTS": "20",
    "FREE_SESSIONS": "10",
    "PLUS_SESSIONS": "200",
    "LLM_ALLOWED_HOSTS": "",
  },
  "env": {
    "production": {
      "name": "wechatai",
      "account_id": "72379006f8869d6bc3ccc4e7615773bc",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "wechatai.app", "custom_domain": true }],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "wechatai-media" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "wechatai-db",
          "database_id": "9b522c7f-e687-4bad-9507-c7831ec7e471",
          "migrations_dir": "migrations",
        },
      ],
      "durable_objects": { "bindings": [{ "name": "ACCOUNTS", "class_name": "PersonalAccount" }] },
      "ratelimits": [
        { "name": "AUTH_LIMIT", "namespace_id": "12001", "simple": { "limit": 20, "period": 60 } },
        { "name": "API_LIMIT", "namespace_id": "12002", "simple": { "limit": 120, "period": 60 } },
      ],
      "vars": {
        "APP_NAME": "微伴",
        "APP_URL": "https://wechatai.app",
        "PUBLIC_SITE_URL": "https://wechatai.app",
        "FREE_DAILY_CREDITS": "100",
        "PLUS_DAILY_CREDITS": "1000",
        "FREE_ASSISTANTS": "3",
        "PLUS_ASSISTANTS": "20",
        "FREE_SESSIONS": "10",
        "PLUS_SESSIONS": "200",
        "LLM_ALLOWED_HOSTS": "",
      },
    },
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
