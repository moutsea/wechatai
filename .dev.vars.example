# Generate separate random values of at least 32 characters. Never commit .dev.vars.
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=
# Optional receive-only server credential. Empty account scope keeps local polling.
WECHAT_RECEIVER_SECRET=
WECHAT_RECEIVER_ACCOUNTS=
# Optional server executor, using a separate random secret; scope = account IDs or all.
EXECUTOR_SECRET=
EXECUTOR_ACCOUNTS=
# Optional aggregate-only server monitoring credential, independent of receiver/executor.
SERVER_MONITOR_SECRET=
# Same random secret as KimiSeek WECHATAI_CONNECT_SECRET (at least 32 characters).
KIMISEEK_CONNECT_SECRET=
# Optional: each OAuth button is enabled only when both values are configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: paid features remain unavailable until Stripe is configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIG_ID=
STRIPE_PLUS_MONTHLY_PRICE_ID=
STRIPE_PLUS_YEARLY_PRICE_ID=
STRIPE_CREDITS_5000_PRICE_ID=
STRIPE_CREDITS_20000_PRICE_ID=
STRIPE_CREDITS_50000_PRICE_ID=
# Optional: admin payment notices. Only live payments can enqueue notices.
# Keep the production token out of local development configuration.
BILLING_NOTIFY_TOKEN=
# all (default) or first_payment
BILLING_NOTIFY_SCOPE=all

# AGT integration preparation; these settings alone do not expose the feature.
# Non-secret vars go in wrangler.jsonc (private production config for production).
AGT_APP_KEY=
# JSON key ring, each value >=32 characters. Retain previous versions for in-flight callbacks.
# Example shape only: {"v1":"<independent-random-secret>"}
# Migrating from the default v1: retain the exact ENCRYPTION_KEY value as v1; add a new v2.
AGT_CALLBACK_KEYS=
