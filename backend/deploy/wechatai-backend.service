[Unit]
Description=WeChatAI Go backend
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=wechatai
Group=wechatai
UMask=0077
StateDirectory=wechatai
StateDirectoryMode=0700
WorkingDirectory=/var/lib/wechatai
Environment=WECHATAI_DATA_DIR=/var/lib/wechatai/accounts
EnvironmentFile=/etc/wechatai/backend.env
ExecStartPre=/opt/wechatai/current/wechatai check-deployment
ExecStart=/opt/wechatai/current/wechatai serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
KillSignal=SIGTERM
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/wechatai
LimitNOFILE=4096
MemoryMax=1G
TasksMax=128

[Install]
WantedBy=multi-user.target
