# Root-owned /etc/wechatai/backend.env, mode 0600. Never commit real values.
# Use standby for a fresh VPS with an empty account directory. For account
# service, set accounts and configure the credentials below. Standby needs none.
WECHATAI_DEPLOY_MODE=standby
# Keep the original ENCRYPTION_KEY when migrating existing accounts.
# Optional independent Grok Routine dispatcher (also supported in standby).
GROK_DISPATCH_SECRET=
WECHATAI_RPC_SECRET=
ENCRYPTION_KEY=
# Match the Worker when a versioned cloud callback key ring is configured.
AGT_CALLBACK_KEY_VERSION=v1
AGT_CALLBACK_KEYS=
AGT_ORIGIN=
AGT_APP_ID=
AGT_TENANT_ID=
AGT_APP_KEY=
# Match the public APP_URL of the Cloudflare edge.
APP_URL=https://wechatai.app
FREE_DAILY_CREDITS=100
PLUS_DAILY_CREDITS=1000

# Optional overrides. The systemd service uses these defaults on the VPS.
# WECHATAI_LISTEN=127.0.0.1:8088
# WECHATAI_DATA_DIR=/var/lib/wechatai/accounts
