{
  "name": "wechatai",
  "version": "0.1.0",
  "private": true,
  "description": "Bring your own AI models and agents into WeChat.",
  "homepage": "https://wechatai.app",
  "bugs": {
    "url": "https://github.com/moutsea/wechatai/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moutsea/wechatai.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "postbuild": "node scripts/sanitize-build.mjs && node scripts/prerender.mjs && node scripts/verify-seo.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test",
    "format": "oxfmt --write .",
    "test": "vitest run && pnpm test:client",
    "test:client": "vitest run --config vitest.client.config.ts",
    "test:browser": "playwright test --config test/browser/playwright.config.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "cf-typegen": "wrangler types env.d.ts --strict-vars false",
    "db:migrate:local": "wrangler d1 migrations apply wechatai-db --local",
    "db:migrate:remote": "node scripts/production.mjs d1 migrations apply wechatai-db --remote",
    "build:production": "CLOUDFLARE_ENV=production pnpm build",
    "deploy": "pnpm build:production && wrangler deploy --config dist/wechatai/wrangler.json",
    "deploy:reminders": "node scripts/production.mjs reminders",
    "reminders:reconcile": "node scripts/reconcile-reminders.mjs",
    "stripe:setup": "node scripts/setup-stripe.mjs",
    "stripe:listen": "node scripts/stripe-listen.mjs",
    "setup:local": "node scripts/setup-local.mjs && pnpm cf-typegen && pnpm db:migrate:local",
    "test:seo": "node scripts/verify-seo.mjs",
    "prebuild": "node scripts/package-openclaw.mjs && node scripts/package-hermes.mjs && node scripts/verify-assets.mjs",
    "test:openclaw": "node --experimental-transform-types --test integrations/openclaw/transport.node-test.ts integrations/openclaw/upgrade.node-test.mjs",
    "test:openclaw:runtime": "node scripts/test-openclaw-runtime.mjs",
    "test:hermes": "node scripts/test-hermes.mjs",
    "cf:production": "node scripts/production.mjs",
    "check:public": "node scripts/check-public.mjs",
    "analytics": "node scripts/analytics-report.mjs",
    "test:receiver": "npm --prefix integrations/wechat-receiver ci --ignore-scripts --no-audit --no-fund && npm --prefix integrations/wechat-receiver test",
    "build:executor": "esbuild src/server/executor/attachments.ts --bundle --platform=node --format=esm --target=node22 --outfile=integrations/wechat-executor/attachments.bundle.mjs",
    "test:executor": "pnpm build:executor && node --test integrations/wechat-executor/executor.test.mjs",
    "test:monitor": "node --test integrations/server-monitor/collector.test.mjs"
  },
  "dependencies": {
    "@better-auth/core": "1.6.26",
    "@better-auth/drizzle-adapter": "^1.6.26",
    "@better-auth/utils": "0.4.2",
    "@better-fetch/fetch": "1.3.1",
    "better-auth": "^1.6.26",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "gpt-tokenizer": "4.0.0",
    "hono": "^4.13.0",
    "image-size": "^2.0.4",
    "lucide-react": "^1.29.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "saxes": "^6.0.0",
    "stripe": "^22.4.0",
    "unpdf": "^1.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "0.28.1",
    "happy-dom": "21.0.4",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.119.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.15.0"
}
