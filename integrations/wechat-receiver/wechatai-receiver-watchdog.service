[Unit]
Description=WeChatAI receiver session watchdog
Wants=network-online.target
After=network-online.target wechatai-receiver.service

[Service]
User=wechatai-receiver
Group=wechatai-receiver
EnvironmentFile=/etc/wechatai-receiver.env
ExecStart=/opt/wechatai-receiver/current/receiver-watchdog
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
