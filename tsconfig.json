{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": [
    "src",
    "test",
    "env.d.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.client.config.ts"
  ]
}
